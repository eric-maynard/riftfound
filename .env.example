# Database Configuration
# For local development, you can use a local PostgreSQL instance
# For production, these will be pulled from AWS Secrets Manager
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=riftfound
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
# AWS credentials should be configured via AWS CLI or IAM roles, not here

# Application Settings
NODE_ENV=development
PORT=3001

# Scraper Settings
SCRAPE_INTERVAL_MINUTES=60

# Second event source: Riot's official playriftbound API (default: enabled)
PLAYRIFTBOUND_ENABLED=true
# Delay between playriftbound requests in ms (polite rate limit, default 1000 = ~1 req/sec)
PLAYRIFTBOUND_REQUEST_DELAY_MS=1000
# Anchors swept per run. Riot's API caps each search at a ~161km radius, so there are
# 1000+ anchors worldwide; each run sweeps a rotating batch (default 150, ~3 min of requests)
PLAYRIFTBOUND_MAX_ANCHORS_PER_RUN=150
# Optional override for Riot's persisted GraphQL query hash.
# Normally left unset - the scraper re-reads the hash from Riot's public
# persisted-query manifest whenever it rotates.
# PLAYRIFTBOUND_QUERY_HASH=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Geocoding Configuration
# Mapbox access token (optional, takes precedence over Photon when set)
# Get one at https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# Enable/disable local Photon geocoder (default: true)
# Set to false in production if not running Photon
PHOTON_ENABLED=true

# Local Photon URL (only used if PHOTON_ENABLED=true)
PHOTON_URL=http://localhost:2322
