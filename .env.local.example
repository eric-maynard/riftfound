# Local Development Configuration
# Copy this to .env for local development

# Database - SQLite (default, zero config)
DB_TYPE=sqlite
SQLITE_PATH=./riftfound.db

# Or use PostgreSQL (requires docker-compose up):
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=riftfound
# DB_USER=riftfound
# DB_PASSWORD=localdevpassword

# Application Settings
NODE_ENV=development
PORT=3001

# Scraper Settings
SCRAPE_INTERVAL_MINUTES=60

# Second event source: Riot's official playriftbound API
# Set to false to scrape only the UVS Games source locally
PLAYRIFTBOUND_ENABLED=true
PLAYRIFTBOUND_REQUEST_DELAY_MS=1000
# Anchors swept per run (lower this for a quick local run)
PLAYRIFTBOUND_MAX_ANCHORS_PER_RUN=150
# PLAYRIFTBOUND_QUERY_HASH=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
